{
  "name": "kztl",
  "publisher": "ondrej-honc",
  "displayName": "KZTL: HTML Syntax and Snippets",
  "icon": "./icons/icon.png",
  "description": "Treats .kztl files exactly like HTML",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ondra-honc/KZTL" },
  "version": "1.1.6",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kztl",
        "extensions": [
          ".kztl"
        ],
        "icon": {
          "light": "./icons/kztl-file.svg",
          "dark": "./icons/kztl-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kztl",
        "scopeName": "text.html.kztl",
        "path": "./syntaxes/kztl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kztl",
        "path": "./syntaxes/kztl.json"
      }
    ],
    "configurationDefaults": {
      "[kztl]": {
        "editor.tabCompletion": "onlySnippets"
      }
    }
  }
}