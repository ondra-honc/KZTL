{
  "name": "kztl",
  "publisher": "ondrej-honc",
  "displayName": "KZTL Language Support",
  "description": "Treats .kztl files exactly like HTML",
  "version": "1.0.5",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kztl",
        "extensions": [
          ".kztl"
        ]
      }
    ],
    "grammars": [
      {
        "language": "kztl",
        "scopeName": "text.html.kztl",
        "path": "./syntaxes/kztl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kztl",
        "path": "./syntaxes/kztl.json"
      }
    ],
    "configurationDefaults": {
      "[kztl]": {
        "editor.tabCompletion": "onlySnippets"
      }
    }
  }
}